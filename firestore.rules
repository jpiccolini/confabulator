rules_version = '2';

// ============================================================
// CONFABULATOR — Firestore security rules
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// Who can do what:
//   Anyone (no sign-in)  read entries, active categories, profiles
//   Members              post favorites, edit/delete their own, suggest categories
//   Admin                everything, plus approve categories and manage members
//
// A member is a Google account whose email has a document in /members.
// The admin is a user whose uid has a document in /admins (created once
// by hand in the Firebase console; see README step 5).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isMember() {
      return isAdmin() || (
        signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(myEmail()))
      );
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }
    function validEntry(d) {
      return d.keys().hasOnly(['title', 'categoryId', 'place', 'story', 'link', 'links', 'imageUrl', 'year',
                               'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && shortText(d.categoryId, 60)
        && shortText(d.place, 120)
        && (!('year' in d) || (d.year is int && d.year >= 1000 && d.year <= 2100))
        && shortText(d.story, 4000)
        && shortText(d.link, 500)
        && (!('links' in d) || (d.links is list && d.links.size() <= 6))
        && shortText(d.imageUrl, 500)
        && shortText(d.authorName, 60)
        && d.updatedAt == request.time;
    }

    // Admin flag: you can see your own, nobody can write it from the app.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Member list, keyed by lower-case email. Members can check their own.
    match /members/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['addedAt', 'note'])
        && shortText(request.resource.data.note, 80);
      allow delete: if isAdmin();
    }

    // Public display names.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && shortText(request.resource.data.displayName, 60)
        && shortText(request.resource.data.photoURL, 500);
      allow delete: if false;
    }

    // Categories: active ones are public; members suggest, admin approves.
    match /categories/{id} {
      allow read: if resource.data.status == 'active'
        || isAdmin()
        || (signedIn() && resource.data.suggestedBy == request.auth.uid);
      allow create: if isAdmin() || (
        isMember()
        && request.resource.data.status == 'pending'
        && request.resource.data.suggestedBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'status', 'suggestedBy', 'suggestedByName', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
      );
      allow update, delete: if isAdmin();
    }

    // Favorites.
    match /entries/{id} {
      allow read: if true;
      allow create: if isMember()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validEntry(request.resource.data);
      allow update: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && validEntry(request.resource.data);
      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
